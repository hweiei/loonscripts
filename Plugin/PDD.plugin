#!name = 拼多多果园
#!desc = v14（2026-11-16 06:52）：修复首页响应解析——2026 版数据包在 user_manor_info 里，旧代码读顶层永远拿 undefined（水滴=0、tubetoken 不更新）；现在从 user_manor_info 取 uid/water/tubetoken 并自动回填存储，一次运行后永久有 uid，不用再抓 Cookie
#!author = hweiei
#!icon = https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/pinduoduo.png
#!tag = 任务
#!system = iOS,iPadOS
#!type = normal
#!version = 14

[Script]
; 1) 抓凭据：完整 Cookie + pdd_user_id + tubetoken（只读 header，不改请求）
http-request ^https?:\/\/mobile\.yangkeduo\.com\/ script-path=https://raw.githubusercontent.com/hweiei/loonscripts/main/Scripts/pdd/pdd_getToken.js, requires-body=false, timeout=10, tag=拼多多凭据抓取, enable=true
; 2) 果园定时任务（已内置 Loon 兼容层，不要再用上游 pdd_guoyuan.js）
cron "30 1,7,12,18,22 * * *" script-path=https://raw.githubusercontent.com/hweiei/loonscripts/main/Scripts/pdd/pdd_guoyuan_loon.js, timeout=300, tag=拼多多果园, enable=true
; 3) 果园任务版：签到 + 任务 accept/draw（2026 新接口，与浇水错开 5 分钟）
cron "35 1,7,12,18,22 * * *" script-path=https://raw.githubusercontent.com/hweiei/loonscripts/main/Scripts/pdd/pdd_fruit_loon.js, timeout=120, tag=拼多多果园任务, enable=true

[Mitm]
hostname = %APPEND% mobile.yangkeduo.com, *.yangkeduo.com, yangkeduo.com, *.pinduoduo.com, pinduoduo.com
