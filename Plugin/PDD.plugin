#!name = 拼多多果园
#!desc = v7（2026-11-16）：修复浇水被拒后 token 失效引发的 500，摘掉上游 10 倍空转循环，日志每 10 次一行
#!author = hweiei
#!icon = https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/pinduoduo.png
#!tag = 任务
#!system = iOS,iPadOS
#!type = normal
#!version = 7

[Script]
; 1) 抓 AccessToken，写入本地存储 ddgyck（只读 header，不改请求）
http-request ^https?:\/\/([^\/]+\.)?(yangkeduo|pinduoduo)\.com\/ script-path=https://raw.githubusercontent.com/hweiei/loonscripts/main/Scripts/pdd/pdd_getToken.js, requires-body=false, timeout=10, tag=拼多多Token抓取, enable=true
; 2) 果园定时任务（已内置 Loon 兼容层，不要再用上游 pdd_guoyuan.js）
cron "30 1,7,12,18,22 * * *" script-path=https://raw.githubusercontent.com/hweiei/loonscripts/main/Scripts/pdd/pdd_guoyuan_loon.js, timeout=300, tag=拼多多果园, enable=true

[Mitm]
hostname = %APPEND% *.yangkeduo.com, yangkeduo.com, *.pinduoduo.com, pinduoduo.com
